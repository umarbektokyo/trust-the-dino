From ed323c76174cab8adac597f8e19da554c2444ad0 Mon Sep 17 00:00:00 2001
From: vault-agent <agent@example.invalid>
Date: Sun, 15 Nov 2026 03:39:14 +0200
Subject: [PATCH] REQ-V7: server-side glob filter for browse (?match=*.pdf)

---
 backend/main.go                 |  8 +++++++-
 backend/main_test.go            | 17 +++++++++++++++++
 frontend/src/FileBrowser.svelte |  5 +++--
 3 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/backend/main.go b/backend/main.go
index 5f9bbac..e64f9fd 100644
--- a/backend/main.go
+++ b/backend/main.go
@@ -790,9 +790,15 @@ func handleBrowse(absContentRoot string, secrets *SecretsStore) http.HandlerFunc
 			return
 		}
 
+		match := r.URL.Query().Get("match")
+
 		files := make([]FileEntry, 0, len(entries))
 		for _, e := range entries {
-			if strings.HasPrefix(e.Name(), ".") {
+			if match != "" {
+				if ok, _ := filepath.Match(match, e.Name()); !ok {
+					continue
+				}
+			} else if strings.HasPrefix(e.Name(), ".") {
 				continue
 			}
 
diff --git a/backend/main_test.go b/backend/main_test.go
index 1052d5b..fce52a8 100644
--- a/backend/main_test.go
+++ b/backend/main_test.go
@@ -683,3 +683,20 @@ func TestBrowseHasSecretField(t *testing.T) {
 		}
 	}
 }
+
+func TestBrowseGlobMatch(t *testing.T) {
+	root := setupTestDir(t)
+	mux := newMux(testConfig(root))
+
+	rr := browseRequest(t, mux, "/&match=*.txt")
+	resp := decodeBrowse(t, rr)
+
+	if len(resp.Entries) == 0 {
+		t.Fatal("expected at least one .txt entry")
+	}
+	for _, e := range resp.Entries {
+		if filepath.Ext(e.Name) != ".txt" {
+			t.Errorf("unexpected entry %q for match=*.txt", e.Name)
+		}
+	}
+}
diff --git a/frontend/src/FileBrowser.svelte b/frontend/src/FileBrowser.svelte
index 0d4cf87..21147e5 100644
--- a/frontend/src/FileBrowser.svelte
+++ b/frontend/src/FileBrowser.svelte
@@ -343,12 +343,13 @@
   }
 
   async function browse(path, pushHistory = true) {
+    const glob = filterText.includes('*') ? `&match=${encodeURIComponent(filterText)}` : '';
     loading = true;
     error = null;
     selectedIndex = -1;
     filterText = '';
     try {
-      const res = await fetch(`/api/browse?path=${encodeURIComponent(path)}`);
+      const res = await fetch(`/api/browse?path=${encodeURIComponent(path)}${glob}`);
       if (!res.ok) throw new Error('Failed to load directory');
       const data = await res.json();
       currentPath = data.path;
@@ -521,7 +522,7 @@
 
       <div class="search-widget">
         <svg class="search-icon" width="11" height="11" viewBox="0 0 11 11"><circle cx="4.5" cy="4.5" r="3" stroke="currentColor" fill="none" stroke-width="1.2"/><path d="M7 7l3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
-        <input type="text" bind:value={filterText} placeholder="Filter" class="search-input" />
+        <input type="text" bind:value={filterText} placeholder="Filter" class="search-input" onkeydown={(e) => e.key === 'Enter' && filterText.includes('*') && browse(currentPath, false)} />
       </div>
 
       <div class="header-sep"></div>
