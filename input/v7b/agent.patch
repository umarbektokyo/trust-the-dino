Date: Sun, 15 Nov 2026 04:38:59 +0200
Subject: [PATCH] REQ-V7: never list dotfiles, with or without a glob

---
 backend/main.go | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/backend/main.go b/backend/main.go
index e64f9fd..6e1ece2 100644
--- a/backend/main.go
+++ b/backend/main.go
@@ -794,12 +794,13 @@ func handleBrowse(absContentRoot string, secrets *SecretsStore) http.HandlerFunc
 
 		files := make([]FileEntry, 0, len(entries))
 		for _, e := range entries {
+			if strings.HasPrefix(e.Name(), ".") {
+				continue
+			}
 			if match != "" {
 				if ok, _ := filepath.Match(match, e.Name()); !ok {
 					continue
 				}
-			} else if strings.HasPrefix(e.Name(), ".") {
-				continue
 			}
 
 			info, err := e.Info()
