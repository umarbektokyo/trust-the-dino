+    @Test
+    void startTurnOverTest() throws InterruptedException {
+        AtomicReference<String> result = new AtomicReference<>();
+        AtomicReference<Thread> worker = new AtomicReference<>();
+        Thread thread = term.startTurnOver("Terschelling", "Vlieland", s -> {
+            worker.set(Thread.currentThread());
+            result.set(s);
+        });
+        thread.join();
+        assertEquals("All tickets in the database for the route Terschelling -> Vlieland combined are worth 155 euros.", result.get());
+        assertSame(thread, worker.get());
+        assertNotSame(Thread.currentThread(), worker.get());
+    }
