+    /**
+     * Runs the turnover calculation (option 3) in its own thread, so the terminal stays
+     * available for other options (like selling tickets) while it runs.
+     * @param departureCity String
+     * @param arrivalCity String
+     * @param onDone receives the turnover message once the calculation has finished.
+     * @return the already started thread, join it to wait for the result.
+     */
+    public Thread startTurnOver(String departureCity, String arrivalCity,
+                                Consumer<String> onDone) {
+        Thread thread = new Thread(() ->
+                onDone.accept(toStringTurnOver(departureCity, arrivalCity)));
+        thread.start();
+        return thread;
+    }
+
