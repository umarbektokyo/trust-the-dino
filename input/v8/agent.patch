From 05a519b9082c9420013f84cadace3f33e14f171f Mon Sep 17 00:00:00 2001
From: vault-agent <agent@example.invalid>
Date: Sun, 15 Nov 2026 04:17:51 +0200
Subject: [PATCH] REQ-V8: show file size in the preview header

---
 frontend/src/Preview.svelte | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/frontend/src/Preview.svelte b/frontend/src/Preview.svelte
index 9913643..ba0aa3e 100644
--- a/frontend/src/Preview.svelte
+++ b/frontend/src/Preview.svelte
@@ -26,6 +26,14 @@
     a.click();
   }
 
+  function formatSize(bytes) {
+    if (bytes < 1024) return `${bytes} B`;
+    const units = ['KB', 'MB', 'GB'];
+    let v = bytes / 1024, i = 0;
+    while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
+    return `${v.toFixed(1)} ${units[i]}`;
+  }
+
   function copyUrl() {
     navigator.clipboard.writeText(`${window.location.origin}${file.url}`);
   }
@@ -42,6 +50,7 @@
         <path d="M5 5.5h6M5 8h6M5 10.5h4" stroke="#5a9fd4" stroke-width="0.9" stroke-linecap="round"/>
       </svg>
       <span class="pv-filename" title={file.name}>{file.name}</span>
+      <span class="pv-size">{formatSize(file.size)}</span>
     </div>
     <div class="pv-actions">
       <button class="bw icon-sq" onclick={copyUrl} title="Copy direct URL">
@@ -106,6 +115,15 @@
     flex-shrink: 0;
     gap: 8px;
   }
+  .pv-size {
+    margin-left: 8px;
+    padding: 1px 6px;
+    border-radius: 3px;
+    background: #3a3a3a;
+    color: #9a9a9a;
+    font-size: 11px;
+  }
+
   .pv-title-row {
     display: flex;
     align-items: center;
-- 
