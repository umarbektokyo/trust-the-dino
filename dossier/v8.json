   "id": "frontend/src/Preview.svelte:formatSize",
   "name": "formatSize",
   "file": "frontend/src/Preview.svelte",
   "kind": "func",
   "layer": "logic",
   "status": "added",
   "signature": "",
   "lines": [
    {
     "op": "+",
     "n": 29,
     "text": "  function formatSize(bytes) {"
    },
    {
     "op": "+",
     "n": 30,
     "text": "    if (bytes < 1024) return `${bytes} B`;"
    },
    {
     "op": "+",
     "n": 31,
     "text": "    const units = ['KB', 'MB', 'GB'];"
    },
    {
     "op": "+",
     "n": 32,
     "text": "    let v = bytes / 1024, i = 0;"
    },
    {
     "op": "+",
     "n": 33,
     "text": "    while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }"
    },
    {
     "op": "+",
     "n": 34,
     "text": "    return `${v.toFixed(1)} ${units[i]}`;"
    },
    {
     "op": "+",
     "n": 35,
     "text": "  }"
    }
   ],
